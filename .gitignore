# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env — .env.example is checked in as the template
!.env.example

# prisma — the SQLite file is rebuilt by `npm run db:reset`, never committed
/prisma/*.db
/prisma/*.db-journal

# runtime uploads land on the local filesystem; keep the folder, drop the files
/public/uploads/*
!/public/uploads/.gitkeep
